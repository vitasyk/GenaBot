BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_IDS=[123456789, 987654321]
ALLOWED_IDS=[111222333]
RESTRICT_ACCESS=True

# Database Configuration (Supabase)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres.projectref:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Redis Configuration (Upstash)
# Format: rediss://:password@host:port
REDIS_URL=rediss://:secret_upstash_password@funny-monkey-12345.upstash.io:6379

# Logging
LOG_LEVEL=INFO

WEATHER_API_KEY=your_weather_api_key
CITY_LAT=50.45
CITY_LON=30.52

# Google Sheets Integration
GOOGLE_CREDENTIALS_PATH=./credentials/google-sheets-key.json
SCHEDULE_SPREADSHEET_ID=your-spreadsheet-id-here

# Energy schedule queue to monitor
QUEUE_NUMBER=1.1

# Schedule image recognition (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key
SCHEDULE_AI_MODEL=claude-haiku-5-5
